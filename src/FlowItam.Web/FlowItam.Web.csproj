<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FlowItam.Core\FlowItam.Core.csproj" />
    <ProjectReference Include="..\FlowItam.Infrastructure\FlowItam.Infrastructure.csproj" />
    <ProjectReference Include="..\FlowItam.Infrastructure.Migrations.Sqlite\FlowItam.Infrastructure.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\FlowItam.Infrastructure.Migrations.PostgreSql\FlowItam.Infrastructure.Migrations.PostgreSql.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>flow-itam-web-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
